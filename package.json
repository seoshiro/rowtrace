{
  "name": "rowtrace-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@12.0.1",
  "scripts": {
    "build": "npm run build -w @seoshiro/rowtrace-core && npm run build -w @seoshiro/rowtrace-cli && npm run build -w @seoshiro/rowtrace-web",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tests/e2e/tsconfig.json",
    "test": "npm run test -w @seoshiro/rowtrace-core && npm run test -w @seoshiro/rowtrace-cli",
    "test:e2e": "playwright test",
    "test:packed": "node scripts/packed-consumer.mjs",
    "preview": "npm run preview -w @seoshiro/rowtrace-web",
    "lint": "eslint .",
    "scan:secrets": "node scripts/security-scan.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
