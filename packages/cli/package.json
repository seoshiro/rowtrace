  "scripts": { "build": "tsc -p tsconfig.json", "typecheck": "tsc -p tsconfig.json --noEmit", "test": "node --test ../../tests/cli/*.test.mjs" },
  "dependencies": { "@seoshiro/rowtrace-core": "0.1.0" }
}
